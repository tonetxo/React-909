{
  "name": "groovegal",
  "private": true,
  "version": "0.1.0",
  "description": "Unha caixa de ritmos e secuenciador por pasos baseado na web inspirado no TR-909 con liña de baixo e funcionalidade de vocoder.",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "start": "concurrently -k \"npm run dev\" \"wait-on tcp:3000 && npm run electron:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "vite build && electron-builder",
    "test": "vitest run"
  },
  "author": {
    "name": "Toño Pita",
    "email": "tonetxo@gmail.com"
  },
  "dependencies": {
    "easymidi": "^3.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/audioworklet": "^0.0.90",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.30",
    "concurrently": "^9.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.example.react-tr-909-groovebox",
    "productName": "GrooveGal",
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json",
      "services/*.js"
    ],
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
